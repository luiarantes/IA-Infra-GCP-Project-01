# Copie para terraform.tfvars para rodar localmente (esse arquivo real fica
# fora do git - veja .gitignore). No CI, essas variaveis vem de secrets do
# GitHub via TF_VAR_* - veja .github/workflows/.

project_id            = "meu-projeto-aiops-test"
project_number        = "123456789012"
region                = "us-central1"
billing_account_id    = "XXXXXX-XXXXXX-XXXXXX"
network_name          = "aiops-vpc"
cluster_name          = "aiops-gke"
budget_amount         = 250
budget_currency_code  = "BRL" # precisa bater com a moeda da sua billing account
enable_budget_alert   = true

# ==============================================================================
# Toggles de Configuração da Stack & Hardware Acelerador
# ==============================================================================

# Modo da Stack de Observabilidade Grafana Labs (Tempo + Loki):
#   - "simple": Modo monolítico leve (armazenamento local /tmp nos nós GKE)
#   - "distributed": Modo enterprise distribuído (Google Cloud Storage / GCS Bucket)
grafana_stack_mode    = "simple"

# Habilita node pool dedicado com GPU Spot (NVIDIA Tesla T4) para inferência dos Agentes AIOps:
#   - true: Cria nó n1-standard-4 com 1x Tesla T4 Spot (~80% mais veloz na análise de logs).
#           ATENÇÃO: Requer upgrade da conta GCP (sair do modo Free Trial restrito) e
#           solicitação de aumento de cota para compute.googleapis.com/nvidia_t4_gpus >= 1.
#   - false: Utiliza apenas nós gerais Spot com CPU (e2-standard-2 / e2-standard-4).
#            Use false como fallback seguro caso sua cota de GPU ainda não tenha sido aprovada.
enable_gpu_pool       = true
gpu_type              = "nvidia-tesla-t4"
gpu_machine_type      = "n1-standard-4"
